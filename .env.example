# ==============================================================================
# DSH (Distributed Software Harness) - Environment Configuration Example
# Copy this file to .env and fill in the values appropriate for your deployment.
# NEVER commit real secret values, API keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Coordination Authority (Required)
# ------------------------------------------------------------------------------
# DSH uses PostgreSQL as the single coordination/lease/claim authority.
# Replace with your local or containerized PostgreSQL instance connection URI.
DSH_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/dsh

# ------------------------------------------------------------------------------
# 2. API Provider Credentials (Optional - configure as needed for your PM profiles)
# ------------------------------------------------------------------------------
# Direct API execution keys referenced by config/api-providers.example.yaml
# and production PM profile registries.
DSH_API_OPENROUTER_KEY=
DSH_API_DEEPSEEK_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Runtime & Isolation Policies (Recommended Defaults)
# ------------------------------------------------------------------------------
# Enable task-scoped worktree isolation for concurrent execution safety (exact string '1' required)
DSH_P24_TASK_WORKSPACE_ISOLATION_ENABLED=1

# Enable durable artifact handoff contract (canonical report plane, exact string '1' required)
DSH_P20_ARTIFACT_V1_ENABLED=1

# ------------------------------------------------------------------------------
# 4. Telegram Owner Transport (Optional)
# ------------------------------------------------------------------------------
# Only required if using Telegram remote-control transport.
# Normal Desktop/CLI usage does not require Telegram credentials.
# Referenced by `token_env: DSH_TELEGRAM_BOT_TOKEN` in your runtime YAML configuration.
DSH_TELEGRAM_BOT_TOKEN=
